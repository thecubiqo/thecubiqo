{
    "$schema": "https://railway.app/railway.schema.json",
    "build": {
        "builder": "DOCKERFILE",
        "dockerfilePath": "social-army/Dockerfile"
    },
    "deploy": {
        "startCommand": "npx tsx src/worker.ts",
        "restartPolicyType": "ON_FAILURE",
        "restartPolicyMaxRetries": 10,
        "healthcheckPath": null,
        "numReplicas": 1
    }
}