{
    "id": "in",
    "countryCode": "IN",
    "name": "India",
    "locale": "en-IN",

    "routing": {
      "path": "/in",
      "domain": null,
      "defaultRoute": "regional",
      "mainEnabled": true,
      "regionalEnabled": true
    },

    "localization": {
      "timezone": "Asia/Kolkata",
      "currency": "INR",
      "dateFormat": "DD/MM/YYYY",
      "dialects": ["Indian English", "Hinglish"]
    },

    "cultural": {
      "festivals": [
        { "name": "New Year's Day", "date": "01-01", "type": "national" },
        { "name": "Republic Day", "date": "01-26", "type": "national" },
        { "name": "Holi", "date": "variable", "type": "cultural" },
        { "name": "Eid", "date": "variable", "type": "religious" },
        { "name": "Independence Day", "date": "08-15", "type": "national" },
        { "name": "Gandhi Jayanti", "date": "10-02", "type": "national" },
        { "name": "Diwali", "date": "variable", "type": "cultural" },
        { "name": "Christmas", "date": "12-25", "type": "religious" }
      ],
      "greetings": {
        "morning": "Good morning",
        "afternoon": "Good afternoon",
        "evening": "Good evening",
        "informal": "Namaste"
      },
      "references": [
        "Monsoon and summer heat",
        "Chai culture",
        "Cricket",
        "Bollywood and regional cinema",
        "Indian Railways",
        "Auto-rickshaws and traffic",
        "Street food and regional cuisines",
        "Jugaad (creative problem-solving)"
      ]
    },

    "appearance": {
      "defaultColor": "SAFFRON",
      "performanceMode": "full",
      "theme": "dark"
    },

    "features": {
      "voice": true,
      "chat": true,
      "memory": true,
      "auth": true
    },

    "ai": {
      "systemPromptAdditions":
        "User is from India. Use Indian English where natural, and be comfortable with Hinglish phrases. Be familiar with Indian culture, festivals like Diwali and Holi, local trains and traffic, chai breaks, and cricket references. Understand mentions of Bollywood, Indian cities, and typical Indian humour and sarcasm.",
      "toneModifiers": ["polite", "friendly", "light-humour"]
    }
  }