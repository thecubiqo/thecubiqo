# Encryption Key for sensitive data
# Get from: Generate with: openssl rand -base64 32
ENCRYPTION_KEY=base64_32_char_key_here

# OAuth Token Encryption Key
# Get from: Generate with: openssl rand -hex 32
OAUTH_ENCRYPTION_KEY=hex_64_char_key_here

# Secret for cron job authentication
# Get from: Generate secure random string
CRON_SECRET=secure_random_string_here

# Sentry DSN for error tracking
