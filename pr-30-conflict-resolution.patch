+
+  return (
+    <div className={`${colorClasses[color]} border-2 rounded-lg p-6`}>
+      <h3 className="text-gray-400 text-sm mb-2">{title}</h3>
+      <p className="text-3xl font-bold mb-1">{value}</p>
+      <p className="text-sm text-gray-500">{subtitle}</p>
+    </div>
