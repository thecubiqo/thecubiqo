+    return NextResponse.json({ agent: {
+      id: agent.id,
+      name: agent.name,
+      model: agent.model,
+      tools: agent.tools,
+      status: agent.status,
+      workspace: agent.workspace,
+      createdAt: agent.createdAt,
+    }});
+  } catch (error) {
+    return NextResponse.json(
+      { error: error instanceof Error ? error.message : 'Failed to create agent' },
+      { status: 500 }
+    );
