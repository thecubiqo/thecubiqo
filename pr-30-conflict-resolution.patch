+      localStorage.setItem(STORAGE_KEYS.CUBE_SIZE, cubeSize.toString())
+      localStorage.setItem(STORAGE_KEYS.SHAPE_TYPE, shapeType)
+      localStorage.setItem(STORAGE_KEYS.SHOW_EYES, showEyes.toString())
