+
+      if (!response.ok) {
+        return {
+          success: false,
+          output: '',
+          error: `Search API error: ${response.status}`,
+        };
+      }
+
+      const data = await response.json();
+      const results = data.web?.results || [];
+
+      const formatted = results.map((r: any, i: number) => ({
