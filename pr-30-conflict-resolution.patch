+<body>
+
+  <div id="loading-screen" class="loading-screen">
+    <div class="loading-spinner"></div>
+    <div class="loading-text">Initializing consciousness...</div>
+    <div class="loading-text" style="margin-top:10px;font-size:12px;opacity:.5;">v2.3.3</div>
+  </div>
+
+  <div id="canvas-container"></div>
+
+  <header class="header px-4 sm:px-6 py-3 sm:py-4">
+    <div class="header-content flex justify-between items-center w-full  mx-auto">
+      <div class="flex items-center gap-2 sm:gap-3">
+        <img src="/image.png" alt="CubiQo Logo" class="logo-img w-7 h-7 sm:w-10 sm:h-10 object-contain" />
+        <span class="logo-text font-bold tracking-widest text-black dark:text-white text-sm sm:text-base">CubiQo™</span>
+      </div>
+      <div class="flex items-center gap-2 sm:gap-4">
+        <div class="header-subtitle text-gray-500 dark:text-gray-400 text-xs hidden md:block">
+          CubiQo™ for simulating conversations
+        </div>
+        <button id="theme-toggle" aria-label="Toggle theme">
+          <span class="theme-text hidden sm:inline">Light</span>
+        </button>
+      </div>
+    </div>
+    <div class="header-subtitle text-gray-500 dark:text-gray-400 text-right text-xs block md:hidden text-center mt-2 ">
+      CubiQo™ for simulating conversations
+    </div>
+  </header>
+
+
+  <div id="voice-ui">
+    <button id="voice-btn" aria-label="Voice input">
+      <svg id="mic-icon" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor"
+        width="26" height="26">
+        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
+          d="M12 1.5a3 3 0 013 3v7a3 3 0 01-6 0v-7a3 3 0 013-3zM19.5 10.5a7.5 7.5 0 01-15 0M12 19.5v3" />
+      </svg>
+    </button>
+  </div>
+
+  <div id="talk-text">Talk to Cubiqo™</div>
+
+  <div id="transcript"
+    class="fixed bottom-48 left-6 right-6 max-w-md mx-auto bg-black/50 backdrop-blur-md rounded-lg p-4 text-sm text-gray-300 max-h-32 overflow-y-auto hidden">
+  </div>
+
+  <footer>
+    <p>Providing temporary use of online non-downloadable<br />AI chatbot software.</p>
+    <p>© 2025 Cubiqo United Inc., Jersey City, NJ.</p>
+    <p>All rights reserved.</p>
+  </footer>
+
+  <script type="module" src="./src/main.js?v=12"></script>
+
+  <script>
+    const toggleBtn = document.getElementById('theme-toggle');
+    const html = document.documentElement;
+    const themeIcon = toggleBtn.querySelector('.theme-icon');
+    const themeText = toggleBtn.querySelector('.theme-text');
+
+    function setTheme(dark) {
+      if (dark) {
+        html.classList.add('dark');
+        html.classList.remove('light');
+        themeText.textContent = 'Light';
+      } else {
+        html.classList.remove('dark');
+        html.classList.add('light');
+        themeText.textContent = 'Dark';
+      }
+    }
+
+    const storedTheme = localStorage.getItem('theme');
+    const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
+    setTheme(storedTheme === 'dark' || (!storedTheme && prefersDark));
+
+    toggleBtn.addEventListener('click', () => {
+      const isDark = html.classList.contains('dark');
+      setTheme(!isDark);
+      localStorage.setItem('theme', !isDark ? 'dark' : 'light');
+    });
+  </script>
+
+
+</body>
+
+</html>
