+        headers: { 'Content-Type': 'application/json' },
+        body: JSON.stringify({
+          id: agentId,
+          name,
+          model: {
+            provider: selectedProvider,
+            model: selectedModel,
+            maxTokens,
+            temperature,
+          },
+          tools: Array.from(selectedTools),
