+                    </summary>
+                    <pre className="mt-2 p-2 bg-gray-900 rounded text-xs overflow-x-auto">
+                      {JSON.stringify(log.changes, null, 2)}
+                    </pre>
+                  </details>
+                )}
+              </div>
+            ))}
+          </div>
+        )}
+      </div>
+    </div>
+  );
+}
