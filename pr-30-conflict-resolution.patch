+            {/* Gmail Integration Toggles */}
+            <GmailToggles
+              permissions={gmailPermissions}
+              onToggle={handleToggleGmail}
+              readEnabled={flags.gmail_read_access}
+              writeEnabled={flags.gmail_write_access}
+            />
