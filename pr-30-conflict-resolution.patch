@@ -0,0 +1,441 @@
+/**
+ * 🎨 Cubiqo Styles
+ * Minimalist, functional, beautiful
+ */
+
+* {
+  margin: 0;
+  padding: 0;
+  box-sizing: border-box;
+}
+
+body {
+  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Roboto', 'Oxygen',
+    'Ubuntu', 'Cantarell', 'Fira Sans', 'Droid Sans', 'Helvetica Neue', sans-serif;
+  background: linear-gradient(135deg, #1a1a2e 0%, #16213e 50%, #0f3460 100%);
+  overflow: hidden;
+  color: #fff;
+  -webkit-font-smoothing: antialiased;
+  -moz-osx-font-smoothing: grayscale;
+
+  /* iOS safe area support */
+  padding: env(safe-area-inset-top) env(safe-area-inset-right) env(safe-area-inset-bottom) env(safe-area-inset-left);
+
+  /* Prevent pull-to-refresh on mobile */
+  overscroll-behavior: none;
+
+  /* Improve touch responsiveness */
+  touch-action: pan-x pan-y;
+}
+
+/* Canvas container */
+#canvas-container {
+  width: 100vw;
+  height: 100vh;
+  position: relative;
+
+  /* GPU acceleration hints */
+  will-change: contents;
+  transform: translateZ(0);
+  -webkit-transform: translateZ(0);
+}
+
+/* Manual Mode Toggle - Hidden by default (production) */
+#manual-mode-toggle {
+  position: absolute;
+  top: 20px;
+  right: 20px;
+  z-index: 100;
+  display: none; /* Hidden by default */
+}
+
+/* Show on dev/staging only */
+html.dev-mode #manual-mode-toggle {
+  display: block;
+}
+
+#toggle-manual-mode {
+  display: flex;
+  align-items: center;
+  gap: 8px;
+  padding: 10px 16px;
+  background: rgba(0, 0, 0, 0.6);
+  backdrop-filter: blur(10px);
+  border: 2px solid rgba(255, 255, 255, 0.2);
+  border-radius: 20px;
+  color: rgba(255, 255, 255, 0.6);
+  cursor: pointer;
+  font-size: 14px;
+  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
+  transition: all 0.3s ease;
+}
+
+#toggle-manual-mode:hover {
+  border-color: rgba(255, 255, 255, 0.4);
+  background: rgba(0, 0, 0, 0.7);
+  color: rgba(255, 255, 255, 0.9);
+}
+
+#toggle-manual-mode.active {
+  border-color: #FF6F00; /* Fourth Way color */
+  background: rgba(255, 111, 0, 0.2);
+  color: #FF6F00;
+}
+
+.toggle-icon {
+  font-size: 18px;
+  line-height: 1;
+}
+
+.toggle-text {
+  font-weight: 500;
+  letter-spacing: 0.5px;
+}
+
+/* Color controls */
+#controls {
+  position: absolute;
+  bottom: max(40px, env(safe-area-inset-bottom, 0px) + 20px);
+  left: 50%;
+  transform: translateX(-50%);
+  display: flex;
+  gap: 12px;
+  z-index: 10;
+  transition: opacity 0.3s ease, transform 0.3s ease;
+}
+
+/* Hidden state for color controls */
+#controls.manual-mode-hidden {
+  opacity: 0;
+  pointer-events: none;
+  transform: translateX(-50%) translateY(20px);
+}
+
+.color-btn {
+  width: 60px;
+  height: 60px;
+  border: 2px solid rgba(255, 255, 255, 0.3);
+  border-radius: 12px;
+  cursor: pointer;
+  transition: all 0.3s ease;
+  background: rgba(0, 0, 0, 0.5);
+  backdrop-filter: blur(10px);
+  position: relative;
+  overflow: hidden;
+
+  /* GPU acceleration for smooth animations */
+  will-change: transform, box-shadow;
+  transform: translateZ(0);
+  -webkit-transform: translateZ(0);
+}
+
+.color-btn::before {
+  content: '';
+  position: absolute;
+  inset: 4px;
+  border-radius: 8px;
+  opacity: 0.8;
+}
+
+.color-btn.red::before {
+  background: #C2185B; /* Tamas - Indulgence • Desire */
+}
+
+.color-btn.yellow::before {
+  background: #FFA000; /* Rajas - Activity • Energy */
+}
+
+.color-btn.greenBlue::before {
+  background: #00897B; /* Sattva - Growth • Wellness */
+}
+
+.color-btn.orange::before {
+  background: #FF6F00; /* Fourth Way - Stillness • Awareness */
+}
+
+.color-btn:active {
+  transform: scale(0.95);
+}
+
+.color-btn.active {
+  border-color: rgba(255, 255, 255, 0.8);
+  box-shadow: 0 0 20px rgba(255, 255, 255, 0.5);
+}
+
+/* Voice control UI */
+#voice-ui {
+  position: absolute;
+  bottom: 140px;
+  left: 50%;
+  transform: translateX(-50%);
+  z-index: 10;
+}
+
+#voice-btn {
+  width: 80px;
+  height: 80px;
+  border: 3px solid rgba(255, 255, 255, 0.5);
+  border-radius: 50%;
+  background: rgba(0, 0, 0, 0.7);
+  backdrop-filter: blur(10px);
+  cursor: pointer;
+  display: flex;
+  align-items: center;
+  justify-content: center;
+  font-size: 32px;
+  color: #fff;
+  transition: all 0.3s ease;
+
+  /* GPU acceleration */
+  will-change: transform, box-shadow, border-color;
+  transform: translateZ(0);
+  -webkit-transform: translateZ(0);
+}
+
+#voice-btn:hover {
+  border-color: rgba(255, 255, 255, 0.8);
+  background: rgba(0, 0, 0, 0.8);
+}
+
+#voice-btn.listening {
+  border-color: #C2185B; /* Tamas color for active listening */
+  background: rgba(194, 24, 91, 0.2);
+  animation: pulse 1.5s ease-in-out infinite;
+}
+
+@keyframes pulse {
+  0%, 100% {
+    transform: scale(1);
+    box-shadow: 0 0 0 0 rgba(194, 24, 91, 0.7);
+  }
+  50% {
+    transform: scale(1.05);
+    box-shadow: 0 0 0 20px rgba(194, 24, 91, 0);
+  }
+}
+
+/* Transcript display - HIDDEN (using voice button as status indicator instead) */
+#transcript {
+  display: none;
+}
+
+/* Loading screen */
+#loading-screen {
+  position: fixed;
+  top: 0;
+  left: 0;
+  width: 100%;
+  height: 100%;
+  background: linear-gradient(135deg, #1a1a2e 0%, #16213e 50%, #0f3460 100%);
+  display: flex;
+  flex-direction: column;
+  align-items: center;
+  justify-content: center;
+  z-index: 1000;
+  transition: opacity 0.5s ease, visibility 0.5s ease;
+}
+
+#loading-screen.hidden {
+  opacity: 0;
+  visibility: hidden;
+  pointer-events: none;
+}
+
+.loading-spinner {
+  width: 60px;
+  height: 60px;
+  border: 4px solid rgba(255, 255, 255, 0.2);
+  border-top: 4px solid #FF6F00; /* Fourth Way - default state */
+  border-radius: 50%;
+  animation: spin 1s linear infinite;
+  margin-bottom: 20px;
+}
+
+.loading-text {
+  color: rgba(255, 255, 255, 0.8);
+  font-size: 18px;
+  text-align: center;
+}
+
+@keyframes spin {
+  0% { transform: rotate(0deg); }
+  100% { transform: rotate(360deg); }
+}
+
+/* Error message */
+.error {
+  position: absolute;
+  top: 50%;
+  left: 50%;
+  transform: translate(-50%, -50%);
+  padding: 20px 30px;
+  background: rgba(220, 20, 60, 0.9);
+  border-radius: 12px;
+  color: #fff;
+  font-size: 16px;
+  max-width: 80%;
+  text-align: center;
+  z-index: 100;
+}
+
+/* Tablet responsive (601px - 900px) */
+@media (max-width: 900px) and (min-width: 601px) {
+  .color-btn {
+    width: 55px;
+    height: 55px;
+  }
+
+  #voice-btn {
+    width: 75px;
+    height: 75px;
+    font-size: 30px;
+  }
+}
+
+/* Mobile responsive (max 600px) */
+@media (max-width: 600px) {
+  .color-btn {
+    width: 50px;
+    height: 50px;
+  }
+
+  #controls {
+    gap: 8px;
+    bottom: max(20px, env(safe-area-inset-bottom, 0px) + 10px);
+  }
+
+  #voice-btn {
+    width: 70px;
+    height: 70px;
+    font-size: 28px;
+  }
+
+  #voice-ui {
+    bottom: 110px;
+  }
+
+  #transcript {
+    font-size: 14px;
+    padding: 12px 20px;
+    max-width: 90%;
+  }
+}
+
+/* Very small screens (max 360px) */
+@media (max-width: 360px) {
+  .color-btn {
+    width: 45px;
+    height: 45px;
+  }
+
+  #controls {
+    gap: 6px;
+  }
+
+  #voice-btn {
+    width: 65px;
+    height: 65px;
+    font-size: 24px;
+  }
+
+  #voice-ui {
+    bottom: 100px;
+  }
+
+  #transcript {
+    font-size: 13px;
+    padding: 10px 16px;
+  }
+}
+
+/* Landscape mode on mobile */
+@media (max-width: 900px) and (orientation: landscape) {
+  #controls {
+    bottom: max(15px, env(safe-area-inset-bottom, 0px) + 10px);
+    gap: 10px;
+  }
+
+  .color-btn {
+    width: 45px;
+    height: 45px;
+  }
+
+  #voice-ui {
+    bottom: 90px;
+  }
+
+  #voice-btn {
+    width: 60px;
+    height: 60px;
+    font-size: 24px;
+  }
+
+  #transcript {
+    top: max(20px, env(safe-area-inset-top, 0px) + 10px);
+    font-size: 13px;
+    padding: 10px 16px;
+  }
+}
+
+/* FPS Monitor - Hidden by default (production) */
+#fps-monitor {
+  position: fixed;
+  top: 10px;
+  left: 10px;
+  padding: 8px 12px;
+  background: rgba(0, 0, 0, 0.8);
+  backdrop-filter: blur(10px);
+  border-radius: 8px;
+  border: 1px solid rgba(255, 255, 255, 0.2);
+  font-family: 'Courier New', monospace;
+  font-size: 12px;
+  color: #fff;
+  z-index: 1000;
+  min-width: 140px;
+  line-height: 1.5;
+  display: none; /* Hidden by default */
+}
+
+/* Show on dev/staging only */
+html.dev-mode #fps-monitor {
+  display: block;
+}
+
+#fps-monitor .fps-current {
+  font-weight: bold;
+  font-size: 14px;
+}
+
+#fps-monitor .fps-avg {
+  opacity: 0.7;
+  font-size: 11px;
+}
+
+#fps-monitor.fps-good {
+  border-color: rgba(76, 175, 80, 0.6);
+}
+
+#fps-monitor.fps-medium {
+  border-color: rgba(255, 193, 7, 0.6);
+}
+
+#fps-monitor.fps-bad {
+  border-color: rgba(244, 67, 54, 0.6);
+}
+
+/* Improve touch targets on all mobile devices */
+@media (hover: none) and (pointer: coarse) {
+  .color-btn, #voice-btn {
+    /* Increase touch target size without changing visual size */
+    position: relative;
+  }
+
+  .color-btn::after, #voice-btn::after {
+    content: '';
+    position: absolute;
+    top: -8px;
+    right: -8px;
+    bottom: -8px;
+    left: -8px;
+  }
+}
