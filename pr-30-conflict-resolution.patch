+        padding: 5px 8px;
+        gap: 3px;
+      }
+
+      #voice-btn {
+        width: 52px;
+        height: 52px;
+        font-size: 20px;
+      }
+
+      footer {
+        font-size: 7px;
+      }
+    }
+
+    @media (max-height: 600px) and (orientation: landscape) {
+      #voice-ui {
+        bottom: 60px;
+      }
+
+      #talk-text {
+        bottom: 35px;
+        font-size: 11px;
+      }
+
+      #voice-btn {
+        width: 48px;
+        height: 48px;
+        font-size: 20px;
+      }
+
+      footer {
+        font-size: 8px;
+        bottom: 8px;
+      }
+    }
+
