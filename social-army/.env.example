# Social Army Credentials

# 1. CubiQo Access (To record content)
CUBIQO_URL=https://staging0217.cubiqo.ai
CUBIQO_ADMIN_USER=admin@cubiqo.ai
CUBIQO_ADMIN_PASS=secure_password_here

# 2. GFXToolz.ai (To create content)
GFX_TOOLZ_API_KEY=your_gfxtoolz_key_here

# 3. Supabase (For the worker queue)
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# 4. Social Army Daemon Control
SOCIAL_ARMY_STATUS=ON

# 5. Project identification — scopes this army instance to a specific project
# Matches the NEXT_PUBLIC_SOCIAL_ARMY_PROJECT value in the main app
SOCIAL_ARMY_PROJECT=CubiQo

# 6. WebAuthn / Biometric Authentication
# Must match the domain of the main app (e.g. cubiqo.ai in production)
NEXT_PUBLIC_RP_ID=localhost

# 7. Social Platforms (To post content)
# Format: PLATFORM_USER / PLATFORM_PASS
TWITTER_USER=
TWITTER_PASS=
TIKTOK_USER=
TIKTOK_PASS=
# ... add others as needed
