# CubiQo Environment Variables Template
# Copy this to .env.local and fill in your values

# AI Models (Optional - for hosted version only)
# Leave empty to use BYO (Bring Your Own) mode
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Voice Synthesis
# Get your key from https://elevenlabs.io
ELEVENLABS_API_KEY=

# Database (if using hosted version)
# Leave empty for local development
DATABASE_URL=

# GitHub OAuth (for Founder Portal connections)
# Create OAuth App at: https://github.com/settings/developers
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
NEXT_PUBLIC_GITHUB_CLIENT_ID=

# Encryption (for storing OAuth tokens securely)
# Generate with: openssl rand -base64 32
ENCRYPTION_KEY=

# Vercel OAuth (for deployment integrations)
# Create integration at: https://vercel.com/account/integrations
NEXT_PUBLIC_VERCEL_CLIENT_ID=
VERCEL_CLIENT_SECRET=

# Deployment
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
