# CubiQo Environment Variables Template
# Copy this to .env.local and fill in your values

# ============================================================================
# SUPABASE CONFIGURATION (REQUIRED)
# ============================================================================
# Get these from your Supabase project settings:
# https://app.supabase.com/project/YOUR_PROJECT/settings/api

# Public Supabase URL (safe to expose to client)
# Supports both NEXT_PUBLIC_SUPABASE_URL1 (new) and NEXT_PUBLIC_SUPABASE_URL (old)
NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_URL1=

# Supabase Anonymous Key (safe to expose to client, used for RLS)
# Supports both NEXT_PUBLIC_SUPABASE_ANON_KEY1 (new) and NEXT_PUBLIC_SUPABASE_ANON_KEY (old)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# NEXT_PUBLIC_SUPABASE_ANON_KEY1=

# Supabase Service Role Key (KEEP SECRET - server-side only)
# Used for admin operations that bypass RLS
# Supports both SUPABASE_SERVICE_ROLE_KEY1 (new) and SUPABASE_SERVICE_ROLE_KEY (old)
SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_SERVICE_ROLE_KEY1=

# ============================================================================
# AI MODELS (OPTIONAL)
# ============================================================================
# Leave empty to use BYO (Bring Your Own) mode
# Users can provide their own API keys in the UI

# Claude API Key from Anthropic
ANTHROPIC_API_KEY=

# MiniMax API Key (primary provider)
# Supports both MINIMAX_KEY (new) and MINIMAX_API_KEY (old)
MINIMAX_API_KEY=
# MINIMAX_KEY=

# Mistral API Key (Mixtral - first fallback)
MISTRAL_API_KEY=

# Together AI API Key (Llama - second fallback)
TOGETHER_API_KEY=

# OpenRouter/OpenClaw API Key (alternative routing)
# Supports both OPENROUTER_KEY_CUBIKEY (new) and OPENCLAW_API_KEY (old)
OPENCLAW_API_KEY=
# OPENROUTER_KEY_CUBIKEY=

# ============================================================================
# VOICE SYNTHESIS (OPTIONAL)
# ============================================================================
# Get your key from https://elevenlabs.io
# Required for text-to-speech functionality
ELEVENLABS_API_KEY=

# ============================================================================
# DEPLOYMENT
# ============================================================================
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ============================================================================
# FEATURE FLAGS (OPTIONAL)
# ============================================================================
# Enable admin elevated controls (debug view, bypass confirmations, impersonation)
# Default: true in development, false in production
NEXT_PUBLIC_ENABLE_ADMIN_CONTROLS=true

# ============================================================================
# LEGACY (DEPRECATED)
# ============================================================================
# Old database URL format - no longer used
# DATABASE_URL=
