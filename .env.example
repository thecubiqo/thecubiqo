# CubiQo Environment Variables Template
# Copy this to .env.local and fill in your values

# ============================================================================
# SUPABASE CONFIGURATION (REQUIRED)
# ============================================================================
# Get these from your Supabase project settings:
# https://app.supabase.com/project/YOUR_PROJECT/settings/api

# Public Supabase URL (safe to expose to client)
NEXT_PUBLIC_SUPABASE_URL=

# Supabase Anonymous Key (safe to expose to client, used for RLS)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase Service Role Key (KEEP SECRET - server-side only)
# Used for admin operations that bypass RLS
SUPABASE_SERVICE_ROLE_KEY=

# ============================================================================
# AI MODELS (OPTIONAL)
# ============================================================================
# Leave empty to use BYO (Bring Your Own) mode
# Users can provide their own API keys in the UI

# Claude API Key from Anthropic
ANTHROPIC_API_KEY=

# OpenAI API Key
OPENAI_API_KEY=

# ============================================================================
# VOICE SYNTHESIS (OPTIONAL)
# ============================================================================
# Get your key from https://elevenlabs.io
# Required for text-to-speech functionality
ELEVENLABS_API_KEY=

# ============================================================================
# DEPLOYMENT
# ============================================================================
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ============================================================================
# SELF-HEAL CRON JOB (OPTIONAL)
# ============================================================================
# Secret token to protect the self-heal cron endpoint
# Generate a secure random string (e.g., openssl rand -base64 32)
CRON_SECRET=

# Email configuration for self-heal reports
# FROM: The email address that reports will be sent from (your organization's address)
# TO: The email address that will receive reports (defaults to aditya@cubiqo.ai if not set)
SELF_HEAL_EMAIL_FROM=noreply@cubiqo.ai
SELF_HEAL_EMAIL_TO=aditya@cubiqo.ai

# ============================================================================
# LEGACY (DEPRECATED)
# ============================================================================
# Old database URL format - no longer used
# DATABASE_URL=
