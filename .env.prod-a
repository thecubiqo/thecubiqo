# CubiQo Production-A (Admin) Environment
# For: Owner/Admin access with full features

# Emergent Universal API Integration
# Uses Emergent's managed AI endpoints
NEXT_PUBLIC_USE_EMERGENT=true
EMERGENT_API_URL=https://integrations.emergentagent.com/llm
